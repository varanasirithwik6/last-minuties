# Last Minuties Environment Variables
# Copy this to .env and fill in your credentials

# ============================================================
# Supabase (required for auth + database)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# Gemini API (optional — enables AI ticket extraction)
# Get from: https://aistudio.google.com/app/apikey
# ============================================================
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# App
# ============================================================
VITE_APP_VERSION=1.0.0

# ============================================================
# NOTES:
# - Without Supabase credentials, the app runs in DEMO MODE
#   with sample data. No real auth will work in demo mode.
# - For Supabase phone auth, you need Twilio connected in your
#   Supabase dashboard (Settings > Auth > Phone providers).
#   OR use test phone numbers in Supabase dashboard for local dev.
# - Without Gemini API key, the AI extraction will return
#   realistic mock data instead of real extraction.
# ============================================================
